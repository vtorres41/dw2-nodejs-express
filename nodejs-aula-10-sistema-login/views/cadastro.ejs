<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

<div class="container col-12 col-md-12">
    <div class="card mt-4">
        <div class="card-header">
            <h2>Cadastro de Usuário</h2>
        </div>
        <div class="card-body">
            <form action="/cadastro/novo" method="post">
                <label for="email">Email</label>
                <input type="email" class="form-control" name="email" id="email" placeholder="Digite seu email" required>
                
                <label for="password">Email</label>
                <input type="password" class="form-control" name="password" id="password" placeholder="Digite sua senha" required>

                <button type="submit" class="btn btn-success btn-block mt-2">
                    Cadastrar
                </button>
            </form>
            <hr>
            <h6>já possui conta? <a href="/login">Faça o Login</a></h6>
        </div>
    </div>
</div>
    
<%- include ('partials/footer.ejs') %>
